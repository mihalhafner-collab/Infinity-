<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="hafner_app_store.json" />
        <include domain="file" path="backups" />
        <exclude domain="sharedpref" path="hafner_mcp_sync_meta.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="hafner_app_store.json" />
        <include domain="file" path="backups" />
        <exclude domain="sharedpref" path="hafner_mcp_sync_meta.xml" />
    </device-transfer>
</data-extraction-rules>
