# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by Cloud Run / AI Studio with the HTTPS service URL.
APP_URL="MY_APP_URL"

# Optional overrides (automatically resolved via Cloud Run headers & persisted in Cloud Firestore):
# PUBLIC_MCP_BASE_URL="https://hafner-gruenraum.ai.studio"
# MCP_ADMIN_TOKEN=""

