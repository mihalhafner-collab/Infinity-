# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by Cloud Run / AI Studio with the HTTPS service URL.
APP_URL="MY_APP_URL"

# PUBLIC_MCP_BASE_URL: Optional explicit public HTTPS base URL override for MCP endpoints.
PUBLIC_MCP_BASE_URL=""

# MCP_ADMIN_TOKEN: Optional fixed server-side Bearer secret for private ChatGPT MCP access.
# Set this in Cloud Run / AI Studio Secrets so the key stays constant across container restarts.
# If omitted, the server generates and persists a random 256-bit key in gitignored data/mcp-config.json.
MCP_ADMIN_TOKEN=""
